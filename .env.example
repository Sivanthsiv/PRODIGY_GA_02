# ============================================================
# Environment Variables — copy this file to .env and fill in
# ============================================================

# HuggingFace access token (required for gated models)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Default model ID (non-gated; works without HF token)
MODEL_ID=runwayml/stable-diffusion-v1-5

# Output directory for generated images
OUTPUT_DIR=outputs

# Optional speed/quality defaults (CPU-friendly)
DEFAULT_STEPS=12
DEFAULT_GUIDANCE=6.5
DEFAULT_WIDTH=384
DEFAULT_HEIGHT=384
